Команда.Действие = "КомандаПересчитатьСуммы";

КнопкаФормы = Элементы.Добавить ("ПересчитатьСуммы", Тип("КнопкаФормы"),Элементы.ГруппаШапкаЛево);
КнопкаФормы.ИмяКоманды = "КомандаПересчитатьСуммы";
КнопкаФормы.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
